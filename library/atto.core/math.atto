// HDL backend-owned Atto signed integer math source (future target).
// Not synthesizeable by current fixed-width u1..u64 combinational subset.
define module math as
  pub fnc min_int(int x, int y): int {
    if x < y; do return x; fi
    return y;
  }
  pub fnc max_int(int x, int y): int {
    if x > y; do return x; fi
    return y;
  }
  pub fnc signum_int(int n): int {
    if n < 0; do return -1; fi
    if n > 0; do return 1; fi
    return 0;
  }
  pub fnc contains_closed_int(int value, int lower, int upper): bool {
    if lower > upper; do return false; fi
    return value >= lower && value <= upper;
  }
end
